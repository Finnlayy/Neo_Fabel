# Public example only. Never place real credentials in this file.
APP_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
GEMINI_API_KEY=
# Google Antigravity SDK (pip: google-antigravity) uses GEMINI_API_KEY
# or Vertex ADC via GOOGLE_GENAI_USE_VERTEXAI / GOOGLE_CLOUD_PROJECT.
# Backend Firebase Admin (token verification)
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
# Host path used only with docker-compose.firebase.yml.
FIREBASE_CREDENTIALS_HOST_PATH=
# Frontend Firebase Auth (Vite — public web app config only, never service-account JSON)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TRADINGVIEW_RAPIDAPI_KEY=
BINANCE_API_KEY=
BINANCE_API_SECRET=
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPHAVANTAGE_API_KEY=
# ALPHA_VANTAGE_API_KEY is also accepted for compatibility.
ALPHAVANTAGE_BULK_QUOTES_ENABLED=false
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
# Autonomy: 1=read-only 2=paper 3=supervised 4=autonomous 5=fund-mgmt
KRAKEN_AUTONOMY_LEVEL=2
# Hard gate for live order placement (also requires autonomy >= 3)
KRAKEN_LIVE_TRADING_ENABLED=false
KRAKEN_DEADMAN_SECONDS=600
KRAKEN_MAX_ORDER_SIZE=0.01
KRAKEN_MAX_OPEN_POSITIONS=3
KRAKEN_MAX_TRADES_PER_HOUR=10
KRAKEN_PAIR_ALLOWLIST=BTCUSD,ETHUSD
DATABASE_URL=postgresql+asyncpg://fable:fable@localhost:5432/fable

# Signal Routes — all off by default; paper-only when enabled.
SIGNAL_ROUTES_ENABLED=false
TRADINGVIEW_INGRESS_ENABLED=false
MCP_SIGNAL_ADAPTER_ENABLED=false
SIGNAL_WORKER_ENABLED=false
SIGNAL_EXECUTION_ENABLED=false
AI_ADVISORY_ENABLED=false
# Store the real pepper in a secret manager; never commit it.
SIGNAL_CREDENTIAL_PEPPER=
SIGNAL_MAX_BODY_BYTES=16384
SIGNAL_MAX_AGE_SECONDS=300
SIGNAL_FUTURE_SKEW_SECONDS=30
ADVISORY_PROVIDER=fake
ADVISORY_MODEL=deterministic-fake-v1
ADVISORY_TIMEOUT_SECONDS=5
