# ==================================================================
# SECURITY WARNING: DO NOT ADD REAL CREDENTIALS TO THIS FILE
# This file is tracked by version control. Copy it to `.env.local`
# and store all real credentials only in that untracked file.
# Paper-first defaults are enforced below.
# ==================================================================

APP_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://fable:fable@localhost:5432/fable

# --- Firebase web app ---
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=your_google_application_credentials_here_DO_NOT_COMMIT
VITE_FIREBASE_API_KEY=your_vite_firebase_api_key_here_DO_NOT_COMMIT
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MEASUREMENT_ID=

# --- AI providers ---
GEMINI_API_KEY=your_gemini_api_key_here_DO_NOT_COMMIT
GEMINI_DEFAULT_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_SECONDS=45
AI_CHAT_ENABLED=true
AI_ALLOW_DETERMINISTIC_FALLBACK=false
ORCHESTRATOR_ADVISORY_ENABLED=false
AI_PROVIDER_ORDER=gemini,openrouter,groq,cerebras,aiprimetech
AI_PROVIDER_ROTATE=false
GOOGLE_CLOUD_PROJECT=
OPENAI_API_KEY=your_openai_api_key_here_DO_NOT_COMMIT
OPENROUTER_API_KEY=your_openrouter_api_key_here_DO_NOT_COMMIT
OPENROUTER_DEFAULT_MODEL=openrouter/free
GROQ_API_KEY=your_groq_api_key_here_DO_NOT_COMMIT
CEREBRAS_API_KEY=your_cerebras_api_key_here_DO_NOT_COMMIT
XAI_API_KEY=your_xai_api_key_here_DO_NOT_COMMIT
MOONSHOT_API_KEY=your_moonshot_api_key_here_DO_NOT_COMMIT
BYTEPLUS_ARK_API_KEY=your_byteplus_ark_api_key_here_DO_NOT_COMMIT

# --- Market data ---
ALPHAVANTAGE_API_KEY=your_alphavantage_api_key_here_DO_NOT_COMMIT
ALPHAVANTAGE_BULK_QUOTES_ENABLED=false
FINNHUB_API_KEY=your_finnhub_api_key_here_DO_NOT_COMMIT

# --- Telegram ---
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here_DO_NOT_COMMIT
TELEGRAM_CHAT_ID=
TELEGRAM_CHANNEL=manus
TELEGRAM_TIMEOUT_SECONDS=20
TELEGRAM_POLL_LIMIT=50
TELEGRAM_NOTIFICATIONS_ENABLED=false
GLINT_TELEGRAM_CHAT_ID=
GLINT_BOT_USERNAME=
MANUS_TELEGRAM_CHAT_ID=
MANUS_BOT_USERNAME=

# --- Kraken (paper-first; live trading OFF) ---
KRAKEN_API_KEY=your_kraken_api_key_here_DO_NOT_COMMIT
KRAKEN_API_SECRET=your_kraken_api_secret_here_DO_NOT_COMMIT
KRAKEN_FUTURES_API_KEY=your_kraken_futures_api_key_here_DO_NOT_COMMIT
KRAKEN_FUTURES_API_SECRET=your_kraken_futures_api_secret_here_DO_NOT_COMMIT
KRAKEN_AUTONOMY_LEVEL=2
KRAKEN_LIVE_TRADING_ENABLED=false
KRAKEN_LIVE_ALGO_ENABLED=false
KRAKEN_DEADMAN_SECONDS=600
KRAKEN_MAX_ORDER_SIZE=25
KRAKEN_MAX_NOTIONAL=2
KRAKEN_MAX_OPEN_POSITIONS=3
KRAKEN_MAX_TRADES_PER_HOUR=10
KRAKEN_MIN_TRADE_INTERVAL_SECONDS=30
KRAKEN_PAIR_ALLOWLIST=ADAUSD,XRPUSD,ADAEUR,XRPEUR
KRAKEN_BINARY=kraken

# --- Other exchanges (reserved / future wiring) ---
BYBIT_API_KEY=your_bybit_api_key_here_DO_NOT_COMMIT
BYBIT_API_SECRET=your_bybit_api_secret_here_DO_NOT_COMMIT
PIONEX_API_KEY=your_pionex_api_key_here_DO_NOT_COMMIT
PIONEX_API_SECRET=your_pionex_api_secret_here_DO_NOT_COMMIT
PIONEX_SIGNAL_WEBHOOK_TOKEN=your_pionex_signal_webhook_token_here_DO_NOT_COMMIT
PIONEX_SIGNAL_TYPE=
GAINIUM_API_KEY=your_gainium_api_key_here_DO_NOT_COMMIT
GAINIUM_API_SECRET=your_gainium_api_secret_here_DO_NOT_COMMIT
BINANCE_API_KEY=your_binance_api_key_here_DO_NOT_COMMIT
BINANCE_API_SECRET=your_binance_api_secret_here_DO_NOT_COMMIT
ALPACA_API_KEY=your_alpaca_api_key_here_DO_NOT_COMMIT
ALPACA_API_SECRET=your_alpaca_api_secret_here_DO_NOT_COMMIT
TRADINGVIEW_RAPIDAPI_KEY=your_tradingview_rapidapi_key_here_DO_NOT_COMMIT

# --- TVAPI / Signal Routes (paper gates stay off until explicitly enabled) ---
TVAPI_ENABLED=false
SIGNAL_ROUTES_ENABLED=false
TRADINGVIEW_INGRESS_ENABLED=false
MCP_SIGNAL_ADAPTER_ENABLED=false
SIGNAL_WORKER_ENABLED=false
SIGNAL_EXECUTION_ENABLED=false
AI_ADVISORY_ENABLED=false
ADVISORY_PROVIDER=fake
ADVISORY_MODEL=deterministic-fake-v1
ADVISORY_TIMEOUT_SECONDS=5
# Store the real pepper in a secret manager; never commit it.
SIGNAL_CREDENTIAL_PEPPER=your_signal_credential_pepper_here_DO_NOT_COMMIT
SIGNAL_MAX_BODY_BYTES=16384
SIGNAL_MAX_AGE_SECONDS=300
SIGNAL_FUTURE_SKEW_SECONDS=30

# --- Local tooling ---
GITHUB_PAT=your_github_pat_here_DO_NOT_COMMIT

# --- Qdrant vector index (paper/dev) ---
QDRANT_ENABLED=true
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_here_DO_NOT_COMMIT
QDRANT_COLLECTION=neo_fabel_vectors
QDRANT_VECTOR_SIZE=8
QDRANT_TIMEOUT_SECONDS=10

# Local loopback APIs may use this bypass in development only.
AUTH_DEV_BYPASS=true
PAPER_LOCAL_LEDGER=true
PAPER_KELLY_SIZING_ENABLED=true
PAPER_KELLY_MODE=half_kelly
PAPER_FUTURES_STARTING_MARGIN_USD=10000
# Dynamic paper-trade position sizing — risk-managed per-trade notional.
# PAPER_SIZING_MODE: dynamic_kelly | half_kelly | full_kelly | ai_chronos | fixed_usd | manual
PAPER_SIZING_MODE=dynamic_kelly
# Per-trade ceiling as a fraction of paper capital (1.5 % = 0.015).
# e.g. $10 000 balance → max $150 per trade; $5 000 → max $75. Scales automatically.
PAPER_MAX_NOTIONAL_PCT=0.015
# Kelly risk-fraction band per paper trade (min 1.5 % → max 5 % of capital).
PAPER_MIN_RISK_FRACTION=0.015
PAPER_MAX_RISK_FRACTION=0.05

AIPRIMETECH_API_KEY=your_aiprimetech_api_key_here_DO_NOT_COMMIT
AIPRIMETECH_BASE_URL=https://aiprimetech.io/v1
AIPRIMETECH_DEFAULT_MODEL=gpt-5.4-mini
AIPRIMETECH_DAILY_BUDGET_EUR=1.0
OPENCODE_CONFIG_WRITE=false
OPENCODE_CONFIG_PATH=opencode.json
TRAINING_LOOP_ENABLED=false
TRAINING_LOOP_NIGHT_MODE=false
TVREMIX_API_KEY=your_tvremix_api_key_here_DO_NOT_COMMIT
TVREMIX_MCP_URL=https://tvremix.xyz/api/mcp/v1
TVREMIX_ENABLED=false
TVREMIX_TIMEOUT_SECONDS=45

# --- Fable Engine (internal Grid/DCA generators) ---
FABLE_ENGINE_ENABLED=false
FABLE_ENGINE_DRY_RUN=true
FABLE_ENGINE_POLL_SECONDS=10
FABLE_ENGINE_MARKET_RPM=30
FABLE_ENGINE_ONNX_BIAS=off
FABLE_ENGINE_CANDLE_SOURCE=ccxt
FABLE_ENGINE_INTERVAL=5m
TRADE_AGENT_SCHEDULED_MARKET_SOURCE=tvremix

FIREBASE_CREDENTIALS_HOST_PATH=your_firebase_credentials_host_path_here_DO_NOT_COMMIT
