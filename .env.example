# Public example only. Never place real credentials in this file.
APP_URL=http://localhost:5173
# Include both if you ever open the UI via 127.0.0.1 (Firebase treats them as different origins).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GEMINI_API_KEY=
# Google Antigravity SDK (pip: google-antigravity) uses GEMINI_API_KEY
# or Vertex ADC via GOOGLE_GENAI_USE_VERTEXAI / GOOGLE_CLOUD_PROJECT.
# Backend Firebase Admin (token verification)
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
# Local loopback only: Telegram/paper/AI work without a Firebase service account.
# Keep true for local Windows/Mac; must stay false in production.
APP_ENV=development
AUTH_DEV_BYPASS=true
# Host path used only with docker-compose.firebase.yml.
FIREBASE_CREDENTIALS_HOST_PATH=
# Frontend Firebase Auth (Vite â€” public web app config only, never service-account JSON)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TRADINGVIEW_RAPIDAPI_KEY=
BINANCE_API_KEY=
BINANCE_API_SECRET=
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPHAVANTAGE_API_KEY=
# ALPHA_VANTAGE_API_KEY is also accepted for compatibility.
ALPHAVANTAGE_BULK_QUOTES_ENABLED=false
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
# Autonomy: 1=read-only 2=paper 3=supervised 4=autonomous 5=fund-mgmt
KRAKEN_AUTONOMY_LEVEL=2
# Hard gate for live order placement (also requires autonomy >= 3)
KRAKEN_LIVE_TRADING_ENABLED=false
KRAKEN_DEADMAN_SECONDS=600
KRAKEN_MAX_ORDER_SIZE=0.01
KRAKEN_MAX_OPEN_POSITIONS=3
KRAKEN_MAX_TRADES_PER_HOUR=10
KRAKEN_MIN_TRADE_INTERVAL_SECONDS=30
KRAKEN_PAIR_ALLOWLIST=ADAUSD,XRPUSD,ADAEUR,XRPEUR
# Paper: accept any symbol (manual desk + signal routes). Live still uses KRAKEN_PAIR_ALLOWLIST.
PAPER_ALLOW_ALL_PAIRS=true
PAPER_MAX_OPEN_POSITIONS=20
# Empty = use MARKET_STREAM_SYMBOLS (paper engine scans up to PAPER_MAX_OPEN_POSITIONS pairs)
PAPER_OPPORTUNITY_SYMBOLS=
# Paper ledger (local fallback on Windows; Kraken Pro fee defaults)
PAPER_LOCAL_LEDGER=true
PAPER_STARTING_BALANCE_USD=10000
PAPER_FUTURES_STARTING_MARGIN_USD=10000
PAPER_DEFAULT_MARKET=spot
PAPER_MAKER_FEE_RATE=0
PAPER_TAKER_FEE_RATE=0.0005

# Signal Routes â€” all off by default; paper-only when enabled.
SIGNAL_ROUTES_ENABLED=false
TRADINGVIEW_INGRESS_ENABLED=false
MCP_SIGNAL_ADAPTER_ENABLED=false
# Rust fable-mcp paper bridge → LocalPaperLedger (POST /api/v1/mcp/paper/fill)
FABLE_MCP_BRIDGE_ENABLED=false
# Required when enabled — empty token is rejected (no fail-open).
FABLE_MCP_BRIDGE_TOKEN=
# Rust client (stdio MCP) — points at FastAPI; default pair for place_order
# FABLE_MCP_BRIDGE_URL=http://127.0.0.1:8000
# FABLE_MCP_DEFAULT_PAIR=ADAUSD
SIGNAL_WORKER_ENABLED=false
SIGNAL_EXECUTION_ENABLED=false
AI_ADVISORY_ENABLED=false

# Fable Engine (internal Grid/DCA generators â€” dry-run default; no live orders)
FABLE_ENGINE_ENABLED=false
# false + SIGNAL_EXECUTION_ENABLED=true â†’ worker writes to local paper ledger
FABLE_ENGINE_DRY_RUN=true
FABLE_ENGINE_POLL_SECONDS=10
FABLE_ENGINE_MARKET_RPM=30
FABLE_ENGINE_ONNX_BIAS=off
# Candles: auto = tvremix get_ohlcv when TVREMIX_API_KEY is set, else ccxt public OHLCV.
FABLE_ENGINE_CANDLE_SOURCE=auto
FABLE_ENGINE_INTERVAL=5m
# Store the real pepper in a secret manager; never commit it.
SIGNAL_CREDENTIAL_PEPPER=
SIGNAL_MAX_BODY_BYTES=16384
SIGNAL_MAX_AGE_SECONDS=300
SIGNAL_FUTURE_SKEW_SECONDS=30
ADVISORY_PROVIDER=fake
ADVISORY_MODEL=deterministic-fake-v1
ADVISORY_TIMEOUT_SECONDS=5

# AI chat / orchestrate / vision (multi-provider LLM router)
# Prefer paper-first local: keep KRAKEN_AUTONOMY_LEVEL=2 and KRAKEN_LIVE_TRADING_ENABLED=false
# Failover order: first configured key in AI_PROVIDER_ORDER wins; 429/5xx/timeout â†’ next.
AI_CHAT_ENABLED=true
AI_ALLOW_DETERMINISTIC_FALLBACK=false
AI_PROVIDER_ORDER=gemini,openrouter,groq,cerebras,aiprimetech
AI_PROVIDER_ROTATE=false
GEMINI_TIMEOUT_SECONDS=45
AI_LLM_TIMEOUT_SECONDS=45
GEMINI_DEFAULT_MODEL=gemini-3.5-flash
# Free OpenRouter model (:free) â€” see https://github.com/cheahjs/free-llm-api-resources
OPENROUTER_DEFAULT_MODEL=qwen/qwen3-coder:free
GROQ_DEFAULT_MODEL=llama-3.1-8b-instant
CEREBRAS_DEFAULT_MODEL=llama3.1-8b
# AIPrimeTech OpenAI-compatible gateway (paid). Hard daily EUR cap â€” start at â‚¬1.
# Put the real key only in .env.local (never commit). AIPRIMETECH_API_KEY or OPENAI_API_KEY.
AIPRIMETECH_API_KEY=
AIPRIMETECH_BASE_URL=https://aiprimetech.io/v1
AIPRIMETECH_DEFAULT_MODEL=gpt-5.4-mini
AIPRIMETECH_DAILY_BUDGET_EUR=1.0
# Optional overrides for local cost metering (EUR per 1M tokens); defaults from model catalog.
# AIPRIMETECH_EUR_PER_1M_INPUT=
# AIPRIMETECH_EUR_PER_1M_OUTPUT=
# OpenCode CLI (https://opencode.ai) â€” writes repo-root opencode.json from env on API start.
OPENCODE_CONFIG_WRITE=false
OPENCODE_CONFIG_PATH=opencode.json
# Chat wire budget (UI may keep longer history; server trims before LLM)
AI_CHAT_MAX_MESSAGES=12
AI_CHAT_MAX_CHARS=12000
AI_CHAT_MAX_CONTENT_CHARS=4000
# When true and no LLM key answers, orchestrate/chat use labeled deterministic stubs (tests/dev only).

# TVAPI optimize / chart analyze
TVAPI_ENABLED=true
# TRADINGVIEW_RAPIDAPI_KEY reserved; V1 optimize returns labeled deterministic-sweep.

# Phase 1 â€” Qdrant vector index (paper/dev; no live trading).
# Local Docker: http://localhost:6333  |  Compose service URL: http://qdrant:6333
# Cloud: set QDRANT_URL + QDRANT_API_KEY in .env.local only (never commit secrets).
QDRANT_ENABLED=true
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=neo_fabel_vectors
QDRANT_VECTOR_SIZE=8
QDRANT_TIMEOUT_SECONDS=10

# Academy training loop (synthetic drills only; never places live orders)
# Start loop requires TRAINING_LOOP_ENABLED=true (or APP_ENV=development session-enable on Start).
# For daytime local training set TRAINING_LOOP_NIGHT_MODE=false.
TRAINING_LOOP_ENABLED=true
TRAINING_LOOP_AUTO_START=false
TRAINING_LOOP_NIGHT_MODE=false
TRAINING_LOOP_NIGHT_START=22:00
TRAINING_LOOP_NIGHT_END=06:00
TRAINING_LOOP_DRILLS_PER_HOUR=12
# Academy drills: false = offline fixtures (default); true = try tvremix MCP then fallback
ACADEMY_DRILL_LIVE_DATA=false
# Auto-train only trading-path agents (exclude orchestrator / analytic / Chronos self-teach).
ACADEMY_TRAIN_TRADING_ONLY=true

# Trade Agent — Fable5-style schedules (market scan / label / optimizer). Paper-first.
TRADE_AGENT_ENABLED=false
TRADE_AGENT_AUTO_START=false
TRADE_AGENT_WATCHDOG_ENABLED=true
TRADE_AGENT_WATCHDOG_SECONDS=300

# Idle-market feedback / error guard (trade rationales → agent coaching + light param nudges)
FEEDBACK_ENGINE_ENABLED=true

# Genetic forward optimizer (paper research; no live orders)
GA_OPTIMIZER_ENABLED=true
# Optional absolute overrides; default backend/data/ga_runs and backend/data/ga_cache
# GA_DATA_DIR=
# GA_CACHE_DIR=
GA_DEFAULT_POPULATION=30
GA_DEFAULT_GENERATIONS=50
GA_MAX_SYMBOLS=40
GA_LOOKBACK_BARS=600
GA_TRAIN_RATIO=0.7
GA_FEE_R=0.03
GA_MAX_CONCURRENT_JOBS=1
# cache | binance_fapi | ccxt â€” prefer cache for offline local runs
GA_MARKET_SOURCE=cache

# Phase 2 â€” CCXT + WebSocket market stream (read-only; no live trading / no exchange keys).
MARKET_STREAM_ENABLED=true
MARKET_CCXT_ENABLED=true
MARKET_CCXT_EXCHANGE=kraken
MARKET_STREAM_INTERVAL_SECONDS=5
MARKET_STREAM_SYMBOLS=BTC/USD,ETH/USD,SOL/USD,XRP/USD,ADA/USD,AVAX/USD,DOT/USD,POL/USD

# Telegram Bot API feed (requires TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID above)
TELEGRAM_ENABLED=true
TELEGRAM_TIMEOUT_SECONDS=20
TELEGRAM_POLL_LIMIT=50
TELEGRAM_DAEMON_ENABLED=true
TELEGRAM_DAEMON_INTERVAL_MS=60000
TELEGRAM_DAEMON_THROTTLE_MS=1800000
TELEGRAM_DAEMON_IDLE_SEC=300
TELEGRAM_AUTO_RESPOND=true
# Hourly heartbeat while a live algo session is running
LIVE_SESSION_TELEGRAM_HEARTBEAT_ENABLED=true
LIVE_SESSION_TELEGRAM_HEARTBEAT_SECONDS=3600
# Outbound Signal Routes / paper fills → Telegram (+ UI feed). Alias: TELEGRAM_NOTIFICATIONS_ENABLED
TELEGRAM_TRADE_SIGNALS_ENABLED=true
# API-online heartbeat every 30 minutes (while the backend process is up)
TELEGRAM_SYSTEM_HEARTBEAT_ENABLED=true
TELEGRAM_SYSTEM_HEARTBEAT_SECONDS=1800

# tvremix MCP â€” list/read Pine strategies for the TVAPI optimizer
# Get a tvr_â€¦ key: https://tvremix.xyz/account#api-keys
# Cursor MCP URL: https://tvremix.xyz/api/mcp/v1 (Authorization: Bearer <key>)
TVREMIX_API_KEY=
TVREMIX_MCP_URL=https://tvremix.xyz/api/mcp/v1
TVREMIX_ENABLED=true
TVREMIX_TIMEOUT_SECONDS=45

# Optional provider keys (empty in example â€” put real values only in .env.local)
# OPENAI_API_KEY aliases to AIPRIMETECH_API_KEY when the latter is unset.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
XAI_API_KEY=
MOONSHOT_API_KEY=
BYTEPLUS_ARK_API_KEY=
FINNHUB_API_KEY=
BYBIT_API_KEY=
BYBIT_API_SECRET=
PIONEX_API_KEY=
PIONEX_API_SECRET=
PIONEX_SIGNAL_WEBHOOK_TOKEN=
GAINIUM_API_KEY=
GAINIUM_API_SECRET=
KRAKEN_FUTURES_API_KEY=
KRAKEN_FUTURES_API_SECRET=
GLINT_TELEGRAM_CHAT_ID=
MANUS_TELEGRAM_CHAT_ID=
KRAKEN_MAX_NOTIONAL=2
KRAKEN_LIVE_ALGO_ENABLED=false
