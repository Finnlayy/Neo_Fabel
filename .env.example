# Public example only. Never place real credentials in this file.
APP_URL=http://localhost:5173
# Include both if you ever open the UI via 127.0.0.1 (Firebase treats them as different origins).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GEMINI_API_KEY=
# Google Antigravity SDK (pip: google-antigravity) uses GEMINI_API_KEY
# or Vertex ADC via GOOGLE_GENAI_USE_VERTEXAI / GOOGLE_CLOUD_PROJECT.
# Backend Firebase Admin (token verification)
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
# Host path used only with docker-compose.firebase.yml.
FIREBASE_CREDENTIALS_HOST_PATH=
# Frontend Firebase Auth (Vite — public web app config only, never service-account JSON)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TRADINGVIEW_RAPIDAPI_KEY=
BINANCE_API_KEY=
BINANCE_API_SECRET=
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPHAVANTAGE_API_KEY=
# ALPHA_VANTAGE_API_KEY is also accepted for compatibility.
ALPHAVANTAGE_BULK_QUOTES_ENABLED=false
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
# Autonomy: 1=read-only 2=paper 3=supervised 4=autonomous 5=fund-mgmt
KRAKEN_AUTONOMY_LEVEL=2
# Hard gate for live order placement (also requires autonomy >= 3)
KRAKEN_LIVE_TRADING_ENABLED=false
KRAKEN_DEADMAN_SECONDS=600
KRAKEN_MAX_ORDER_SIZE=0.01
KRAKEN_MAX_OPEN_POSITIONS=3
KRAKEN_MAX_TRADES_PER_HOUR=10
KRAKEN_PAIR_ALLOWLIST=BTCUSD,ETHUSD
DATABASE_URL=postgresql+asyncpg://fable:fable@localhost:5432/fable

# Signal Routes — all off by default; paper-only when enabled.
SIGNAL_ROUTES_ENABLED=false
TRADINGVIEW_INGRESS_ENABLED=false
MCP_SIGNAL_ADAPTER_ENABLED=false
SIGNAL_WORKER_ENABLED=false
SIGNAL_EXECUTION_ENABLED=false
AI_ADVISORY_ENABLED=false
# Store the real pepper in a secret manager; never commit it.
SIGNAL_CREDENTIAL_PEPPER=
SIGNAL_MAX_BODY_BYTES=16384
SIGNAL_MAX_AGE_SECONDS=300
SIGNAL_FUTURE_SKEW_SECONDS=30
ADVISORY_PROVIDER=fake
ADVISORY_MODEL=deterministic-fake-v1
ADVISORY_TIMEOUT_SECONDS=5

# AI chat / orchestrate / vision (Gemini Generative Language API)
# Prefer paper-first local: keep KRAKEN_AUTONOMY_LEVEL=2 and KRAKEN_LIVE_TRADING_ENABLED=false
AI_CHAT_ENABLED=true
AI_ALLOW_DETERMINISTIC_FALLBACK=false
GEMINI_TIMEOUT_SECONDS=45
GEMINI_DEFAULT_MODEL=gemini-2.0-flash
# When true and GEMINI_API_KEY is empty, orchestrate/chat use labeled deterministic stubs (tests/dev only).

# TVAPI optimize / chart analyze
TVAPI_ENABLED=true
# TRADINGVIEW_RAPIDAPI_KEY reserved; V1 optimize returns labeled deterministic-sweep.

# Phase 1 — Qdrant vector index (paper/dev; no live trading).
# Local Docker: http://localhost:6333  |  Compose service URL: http://qdrant:6333
# Cloud: set QDRANT_URL + QDRANT_API_KEY in .env.local only (never commit secrets).
QDRANT_ENABLED=true
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=neo_fabel_vectors
QDRANT_VECTOR_SIZE=8
QDRANT_TIMEOUT_SECONDS=10

# Telegram Bot API feed (requires TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID above)
TELEGRAM_ENABLED=true
TELEGRAM_TIMEOUT_SECONDS=20
TELEGRAM_POLL_LIMIT=50

# Optional provider keys (empty in example — put real values only in .env.local)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
MOONSHOT_API_KEY=
BYTEPLUS_ARK_API_KEY=
FINNHUB_API_KEY=
BYBIT_API_KEY=
BYBIT_API_SECRET=
PIONEX_API_KEY=
PIONEX_API_SECRET=
PIONEX_SIGNAL_WEBHOOK_TOKEN=
GAINIUM_API_KEY=
GAINIUM_API_SECRET=
KRAKEN_FUTURES_API_KEY=
KRAKEN_FUTURES_API_SECRET=
GLINT_TELEGRAM_CHAT_ID=
MANUS_TELEGRAM_CHAT_ID=
