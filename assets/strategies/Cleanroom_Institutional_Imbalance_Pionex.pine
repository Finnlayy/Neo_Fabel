//@version=6
// Clean-room public-description implementation.
// This is not the invite-only Alien_Algorithms source. It independently implements
// common FVG, order-block, liquidity matrix, confluence, and webhook concepts.
strategy(
     title="Cleanroom Institutional Imbalance Framework - Pionex",
     shorttitle="CIIF Px",
     overlay=true,
     initial_capital=100,
     currency=currency.USD,
     default_qty_type=strategy.cash,
     default_qty_value=1,
     pyramiding=1,
     calc_on_every_tick=false,
     margin_long=0,
     margin_short=0,
     process_orders_on_close=true,
     commission_type=strategy.commission.percent,
     commission_value=0.05,
     slippage=2,
     max_boxes_count=120,
     max_lines_count=120,
     max_labels_count=80
)

// ====================================================================================================
// Inputs
// ====================================================================================================
string group_cvmi = "CVMI - Gap Pressure"
int in_max_gaps = input.int(80, "Tracked FVGs", minval=10, maxval=200, group=group_cvmi)
float in_gap_min_atr = input.float(0.05, "Minimum FVG Width ATR", minval=0.0, step=0.01, group=group_cvmi)
float in_inst_quality = input.float(1.45, "Institutional Quality Threshold", minval=0.2, step=0.05, group=group_cvmi)
bool in_spatial_only = input.bool(false, "Spatial Mode Only", group=group_cvmi)
int in_cvmi_len = input.int(120, "CVMI Normalization Length", minval=20, maxval=500, group=group_cvmi)
float in_overbought = input.float(80.0, "CVMI Overbought", minval=50.0, maxval=100.0, group=group_cvmi)
float in_oversold = input.float(20.0, "CVMI Oversold", minval=0.0, maxval=50.0, group=group_cvmi)

string group_somm = "SOMM - HTF Order Blocks"
string in_htf = input.timeframe("60", "Order Block Timeframe", group=group_somm)
float in_htf_disp_atr = input.float(1.0, "HTF Displacement ATR", minval=0.1, step=0.1, group=group_somm)
float in_fail_atr = input.float(0.35, "Failure Buffer ATR", minval=0.0, step=0.05, group=group_somm)
float in_mitigation_trigger = input.float(50.0, "Mitigation Trigger %", minval=1.0, maxval=100.0, group=group_somm)
bool in_draw_ob = input.bool(true, "Draw Active Order Block", group=group_somm)

string group_matrix = "Liquidity Matrix"
bool in_show_matrix = input.bool(true, "Show Liquidity Matrix", group=group_matrix)
string in_matrix_source = input.string("Imbalances", "Matrix Source", options=["Imbalances", "Pivots"], group=group_matrix)
int in_matrix_lookback = input.int(180, "Visible Range Lookback", minval=30, maxval=500, group=group_matrix)
int in_pivot_len = input.int(5, "Pivot Length", minval=2, maxval=20, group=group_matrix)

string group_conf = "Confluence Signals"
bool in_use_session = input.bool(false, "Restrict to Session", group=group_conf)
string in_session = input.session("0930-1600", "Signal Session", group=group_conf)
bool in_trade_exhaust = input.bool(true, "Trade Exhaust Signals", group=group_conf)
bool in_trade_sweep = input.bool(true, "Trade Sweep Signals", group=group_conf)
bool in_trade_break = input.bool(false, "Trade Structural Break Signals", group=group_conf)
bool in_alternate = input.bool(true, "Enforce Alternating Direction", group=group_conf)

string group_risk = "Risk"
float in_sl_atr = input.float(1.5, "Stop ATR", minval=0.1, step=0.1, group=group_risk)
float in_tp_atr = input.float(2.0, "Take Profit ATR", minval=0.1, step=0.1, group=group_risk)
float in_tp_qty = input.float(100.0, "Exit Quantity %", minval=1.0, maxval=100.0, group=group_risk)

string group_px = "Pionex Webhook"
string in_pionex_uuid = input.string("", "Pionex Signal Bot UUID", group=group_px)
bool in_send_close_alerts = input.bool(true, "Send Exit Alerts", group=group_px)

string group_ui = "Dashboard"
bool in_show_dashboard = input.bool(true, "Show Dashboard", group=group_ui)

// ====================================================================================================
// Helpers
// ====================================================================================================
f_clamp(float value, float lo, float hi) =>
    math.max(lo, math.min(hi, value))

f_payload(string signal_name) =>
    string meta = "{\\\"signal\\\":\\\"" + signal_name + "\\\",\\\"engine\\\":\\\"cleanroom_ciif\\\"}"
    "{\"data\":{\"action\":\"{{strategy.order.action}}\",\"contracts\":\"{{strategy.order.contracts}}\",\"position_size\":\"{{strategy.position_size}}\"},\"price\":\"{{close}}\",\"signal_param\":\"" + meta + "\",\"signal_type\":\"" + in_pionex_uuid + "\",\"symbol\":\"{{ticker}}\",\"time\":\"{{timenow}}\"}"

f_quality(float gap_width, float atr_value, float vol_ratio, float close_efficiency) =>
    float width_score = atr_value > 0.0 ? gap_width / atr_value : 0.0
    (width_score + vol_ratio + close_efficiency) / 3.0

// ====================================================================================================
// Base Series
// ====================================================================================================
float atr = ta.atr(14)
float vol_ma = ta.sma(volume, 20)
float vol_ratio = vol_ma > 0.0 ? volume / vol_ma : 1.0
float candle_range = math.max(high - low, syminfo.mintick)
float close_eff = math.abs(close - open) / candle_range
bool confirmed = barstate.isconfirmed
bool session_ok = not in_use_session or not na(time(timeframe.period, in_session))
bool pionex_ready = str.length(in_pionex_uuid) > 0

// ====================================================================================================
// CVMI: Fair Value Gap Pool and Signed Unresolved Pressure
// ====================================================================================================
var array<float> gap_low = array.new<float>()
var array<float> gap_high = array.new<float>()
var array<float> gap_total = array.new<float>()
var array<float> gap_active = array.new<float>()
var array<int> gap_dir = array.new<int>()

bool bull_fvg = low > high[2]
bool bear_fvg = high < low[2]
float bull_gap_width = bull_fvg ? low - high[2] : 0.0
float bear_gap_width = bear_fvg ? low[2] - high : 0.0
bool bull_gap_big = bull_gap_width >= atr * in_gap_min_atr
bool bear_gap_big = bear_gap_width >= atr * in_gap_min_atr

if confirmed and bull_fvg and bull_gap_big
    float q = f_quality(bull_gap_width, atr, vol_ratio, close_eff)
    float retail_weight = in_spatial_only ? 1.0 : f_clamp(2.0 - q / in_inst_quality, 0.25, 2.0)
    float total_weight = bull_gap_width * volume * retail_weight
    array.push(gap_low, high[2])
    array.push(gap_high, low)
    array.push(gap_total, total_weight)
    array.push(gap_active, total_weight)
    array.push(gap_dir, 1)

if confirmed and bear_fvg and bear_gap_big
    float q = f_quality(bear_gap_width, atr, vol_ratio, close_eff)
    float retail_weight = in_spatial_only ? 1.0 : f_clamp(2.0 - q / in_inst_quality, 0.25, 2.0)
    float total_weight = bear_gap_width * volume * retail_weight
    array.push(gap_low, high)
    array.push(gap_high, low[2])
    array.push(gap_total, total_weight)
    array.push(gap_active, total_weight)
    array.push(gap_dir, -1)

while array.size(gap_low) > in_max_gaps
    array.shift(gap_low)
    array.shift(gap_high)
    array.shift(gap_total)
    array.shift(gap_active)
    array.shift(gap_dir)

float cvmi_raw = 0.0
float active_pressure = 0.0
float filled_pressure = 0.0

int gap_count = array.size(gap_low)
if gap_count > 0
    for i = 0 to gap_count - 1
        float gl = array.get(gap_low, i)
        float gh = array.get(gap_high, i)
        float gt = array.get(gap_total, i)
        float ga = array.get(gap_active, i)
        int gd = array.get(gap_dir, i)
        float width = math.max(gh - gl, syminfo.mintick)
        bool touches_gap = high >= gl and low <= gh
        if ga > 0.0 and touches_gap
            float overlap = math.max(0.0, math.min(high, gh) - math.max(low, gl))
            float spatial_decay = f_clamp(overlap / width, 0.0, 1.0)
            float opposing_volume = gd == 1 ? (close < open ? volume : volume * 0.25) : (close > open ? volume : volume * 0.25)
            float volume_decay = in_spatial_only ? 0.0 : f_clamp(opposing_volume / math.max(vol_ma, 1.0), 0.0, 2.0) * 0.20
            float decay = f_clamp(math.max(spatial_decay, volume_decay), 0.0, 1.0)
            ga := ga * (1.0 - decay)
            ga := ga < gt * 0.03 ? 0.0 : ga
            array.set(gap_active, i, ga)
        cvmi_raw += gd * ga
        active_pressure += ga
        filled_pressure += math.max(gt - ga, 0.0)

float cvmi_hi = ta.highest(cvmi_raw, in_cvmi_len)
float cvmi_lo = ta.lowest(cvmi_raw, in_cvmi_len)
float cvmi_norm = cvmi_hi != cvmi_lo ? f_clamp((cvmi_raw - cvmi_lo) / (cvmi_hi - cvmi_lo) * 100.0, 0.0, 100.0) : 50.0

// ====================================================================================================
// SOMM: HTF Order Block State, Mitigation, Failure, and Sweep
// ====================================================================================================
float htf_open = request.security(syminfo.tickerid, in_htf, open, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
float htf_close = request.security(syminfo.tickerid, in_htf, close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
float htf_high = request.security(syminfo.tickerid, in_htf, high, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
float htf_low = request.security(syminfo.tickerid, in_htf, low, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
float htf_prev_open = request.security(syminfo.tickerid, in_htf, open[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
float htf_prev_close = request.security(syminfo.tickerid, in_htf, close[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
float htf_prev_high = request.security(syminfo.tickerid, in_htf, high[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
float htf_prev_low = request.security(syminfo.tickerid, in_htf, low[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
float htf_atr = request.security(syminfo.tickerid, in_htf, ta.atr(14), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
bool htf_bull_fvg = request.security(syminfo.tickerid, in_htf, low > high[2] and close > open and math.abs(close - open) > ta.atr(14) * in_htf_disp_atr, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
bool htf_bear_fvg = request.security(syminfo.tickerid, in_htf, high < low[2] and close < open and math.abs(close - open) > ta.atr(14) * in_htf_disp_atr, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
bool new_htf_bar = ta.change(time(in_htf)) != 0

var float ob_low = na
var float ob_high = na
var int ob_dir = 0
var float ob_mitigation = 0.0
var bool ob_active = false
var bool ob_sweep_armed = false
var box ob_box = na

bool new_bull_ob = confirmed and new_htf_bar and htf_bull_fvg
bool new_bear_ob = confirmed and new_htf_bar and htf_bear_fvg

if new_bull_ob
    ob_low := htf_prev_close < htf_prev_open ? htf_prev_low : htf_low
    ob_high := htf_prev_close < htf_prev_open ? htf_prev_high : htf_high
    ob_dir := 1
    ob_mitigation := 0.0
    ob_active := true
    ob_sweep_armed := false
    if in_draw_ob
        if not na(ob_box)
            box.delete(ob_box)
        ob_box := box.new(bar_index, ob_high, bar_index + 1, ob_low, border_color=color.new(color.lime, 25), bgcolor=color.new(color.lime, 88), extend=extend.right)

if new_bear_ob
    ob_low := htf_prev_close > htf_prev_open ? htf_prev_low : htf_low
    ob_high := htf_prev_close > htf_prev_open ? htf_prev_high : htf_high
    ob_dir := -1
    ob_mitigation := 0.0
    ob_active := true
    ob_sweep_armed := false
    if in_draw_ob
        if not na(ob_box)
            box.delete(ob_box)
        ob_box := box.new(bar_index, ob_high, bar_index + 1, ob_low, border_color=color.new(color.red, 25), bgcolor=color.new(color.red, 88), extend=extend.right)

float ob_width = math.max(ob_high - ob_low, syminfo.mintick)
bool in_ob_zone = ob_active and high >= ob_low and low <= ob_high
bool ob_failed = false
bool bull_sweep = false
bool bear_sweep = false

if ob_active
    if in_ob_zone
        float penetration = ob_dir == 1 ? f_clamp((ob_high - low) / ob_width * 100.0, 0.0, 100.0) : f_clamp((high - ob_low) / ob_width * 100.0, 0.0, 100.0)
        ob_mitigation := math.max(ob_mitigation, penetration)
    if ob_dir == 1 and close < ob_low - htf_atr * in_fail_atr
        ob_failed := true
        ob_active := false
    if ob_dir == -1 and close > ob_high + htf_atr * in_fail_atr
        ob_failed := true
        ob_active := false
    if ob_dir == 1 and close < ob_low
        ob_sweep_armed := true
    if ob_dir == -1 and close > ob_high
        ob_sweep_armed := true
    bull_sweep := ob_dir == 1 and ob_sweep_armed and close > ob_low and close <= ob_high
    bear_sweep := ob_dir == -1 and ob_sweep_armed and close < ob_high and close >= ob_low
    if bull_sweep or bear_sweep
        ob_sweep_armed := false

if in_draw_ob and not na(ob_box)
    box.set_right(ob_box, bar_index + 1)
    box.set_bgcolor(ob_box, ob_active ? (ob_dir == 1 ? color.new(color.lime, 88) : color.new(color.red, 88)) : color.new(color.gray, 92))

// ====================================================================================================
// Pivot Pool for Alternate Matrix Source
// ====================================================================================================
var array<float> pivot_price = array.new<float>()
var array<float> pivot_weight = array.new<float>()
var array<bool> pivot_filled = array.new<bool>()
var array<int> pivot_dir = array.new<int>()

float ph = ta.pivothigh(high, in_pivot_len, in_pivot_len)
float pl = ta.pivotlow(low, in_pivot_len, in_pivot_len)

if confirmed and not na(ph)
    array.push(pivot_price, ph)
    array.push(pivot_weight, volume[in_pivot_len])
    array.push(pivot_filled, false)
    array.push(pivot_dir, -1)

if confirmed and not na(pl)
    array.push(pivot_price, pl)
    array.push(pivot_weight, volume[in_pivot_len])
    array.push(pivot_filled, false)
    array.push(pivot_dir, 1)

while array.size(pivot_price) > 120
    array.shift(pivot_price)
    array.shift(pivot_weight)
    array.shift(pivot_filled)
    array.shift(pivot_dir)

int pivot_count = array.size(pivot_price)
if pivot_count > 0
    for i = 0 to pivot_count - 1
        float pp = array.get(pivot_price, i)
        bool pf = array.get(pivot_filled, i)
        int pd = array.get(pivot_dir, i)
        bool swept = pd == -1 ? high >= pp : low <= pp
        if not pf and swept
            array.set(pivot_filled, i, true)

// ====================================================================================================
// Confluence Engine and Strategy Execution
// ====================================================================================================
bool mitigated_enough = ob_active and ob_mitigation >= in_mitigation_trigger
bool bull_exhaust = confirmed and session_ok and ob_dir == 1 and mitigated_enough and cvmi_norm <= in_oversold and close > open
bool bear_exhaust = confirmed and session_ok and ob_dir == -1 and mitigated_enough and cvmi_norm >= in_overbought and close < open
bool bull_break = confirmed and session_ok and ob_failed and ob_dir == -1 and close > ob_high
bool bear_break = confirmed and session_ok and ob_failed and ob_dir == 1 and close < ob_low

var int last_signal_dir = 0
bool flat = strategy.position_size == 0
bool can_long = not in_alternate or last_signal_dir != 1
bool can_short = not in_alternate or last_signal_dir != -1
bool long_signal = flat and can_long and ((in_trade_exhaust and bull_exhaust) or (in_trade_sweep and bull_sweep) or (in_trade_break and bull_break))
bool short_signal = flat and can_short and ((in_trade_exhaust and bear_exhaust) or (in_trade_sweep and bear_sweep) or (in_trade_break and bear_break))

string long_reason = bull_sweep ? "bull_sweep" : bull_break ? "bull_break" : "bull_exhaust"
string short_reason = bear_sweep ? "bear_sweep" : bear_break ? "bear_break" : "bear_exhaust"
string long_payload = pionex_ready ? f_payload(long_reason) : ""
string short_payload = pionex_ready ? f_payload(short_reason) : ""
string exit_payload = pionex_ready ? f_payload("risk_exit") : ""

if long_signal
    strategy.entry("Long", strategy.long, alert_message=long_payload)
    last_signal_dir := 1

if short_signal
    strategy.entry("Short", strategy.short, alert_message=short_payload)
    last_signal_dir := -1

if strategy.position_size > 0
    float long_sl = strategy.position_avg_price - atr * in_sl_atr
    float long_tp = strategy.position_avg_price + atr * in_tp_atr
    strategy.exit("Long Exit", from_entry="Long", stop=long_sl, limit=long_tp, qty_percent=in_tp_qty, alert_message=in_send_close_alerts ? exit_payload : "")

if strategy.position_size < 0
    float short_sl = strategy.position_avg_price + atr * in_sl_atr
    float short_tp = strategy.position_avg_price - atr * in_tp_atr
    strategy.exit("Short Exit", from_entry="Short", stop=short_sl, limit=short_tp, qty_percent=in_tp_qty, alert_message=in_send_close_alerts ? exit_payload : "")

// ====================================================================================================
// Visuals
// ====================================================================================================
plot(cvmi_norm, title="CVMI Normalized", color=color.new(color.aqua, 0), display=display.data_window)
hline(in_overbought, "CVMI Overbought", color=color.new(color.red, 35), linestyle=hline.style_dotted, display=display.data_window)
hline(in_oversold, "CVMI Oversold", color=color.new(color.lime, 35), linestyle=hline.style_dotted, display=display.data_window)
plot(strategy.position_size != 0 ? strategy.position_avg_price : na, title="Average Entry", color=color.new(color.white, 0), style=plot.style_linebr)

plotshape(bull_exhaust, title="Bull Exhaust", style=shape.labelup, text="EXH", color=color.new(color.lime, 0), textcolor=color.black, location=location.belowbar, size=size.tiny)
plotshape(bear_exhaust, title="Bear Exhaust", style=shape.labeldown, text="EXH", color=color.new(color.red, 0), textcolor=color.white, location=location.abovebar, size=size.tiny)
plotshape(bull_sweep, title="Bull Sweep", style=shape.triangleup, color=color.new(color.teal, 0), location=location.belowbar, size=size.tiny)
plotshape(bear_sweep, title="Bear Sweep", style=shape.triangledown, color=color.new(color.orange, 0), location=location.abovebar, size=size.tiny)

// ====================================================================================================
// Dashboard and Liquidity Matrix
// ====================================================================================================
var table dash = table.new(position.top_right, 3, 6, bgcolor=color.new(color.black, 78), border_width=1, border_color=color.new(color.gray, 45))
var table matrix = table.new(position.middle_right, 4, 12, bgcolor=color.new(color.black, 82), border_width=1, border_color=color.new(color.gray, 55))

if in_show_dashboard and barstate.islast
    string ob_state = ob_active ? (ob_dir == 1 ? "Bull OB" : "Bear OB") : "No Active OB"
    color ob_color = ob_active ? (ob_dir == 1 ? color.lime : color.red) : color.gray
    table.cell(dash, 0, 0, "CIIF", text_color=color.white, bgcolor=color.new(color.blue, 55))
    table.cell(dash, 1, 0, "CVMI", text_color=color.white, bgcolor=color.new(color.blue, 55))
    table.cell(dash, 2, 0, "PIONEX", text_color=color.white, bgcolor=color.new(color.blue, 55))
    table.cell(dash, 0, 1, ob_state, text_color=ob_color)
    table.cell(dash, 1, 1, str.tostring(cvmi_norm, "#.0"), text_color=cvmi_norm >= in_overbought ? color.red : cvmi_norm <= in_oversold ? color.lime : color.white)
    table.cell(dash, 2, 1, pionex_ready ? "UUID SET" : "UUID MISSING", text_color=pionex_ready ? color.lime : color.orange)
    table.cell(dash, 0, 2, "Mitigation", text_color=color.white)
    table.cell(dash, 1, 2, str.tostring(ob_mitigation, "#.0") + "%", text_color=ob_mitigation >= in_mitigation_trigger ? color.lime : color.white)
    table.cell(dash, 2, 2, strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT", text_color=strategy.position_size > 0 ? color.lime : strategy.position_size < 0 ? color.red : color.gray)
    table.cell(dash, 0, 3, "Active/Filled", text_color=color.white)
    table.cell(dash, 1, 3, str.tostring(active_pressure, "#") + " / " + str.tostring(filled_pressure, "#"), text_color=color.white)
    table.cell(dash, 2, 3, in_matrix_source, text_color=color.white)

if in_show_matrix and barstate.islast
    int rows = 10
    float range_high = ta.highest(high, in_matrix_lookback)
    float range_low = ta.lowest(low, in_matrix_lookback)
    float row_step = math.max((range_high - range_low) / rows, syminfo.mintick)
    table.cell(matrix, 0, 0, "Price", text_color=color.white, bgcolor=color.new(color.blue, 55))
    table.cell(matrix, 1, 0, "Active", text_color=color.white, bgcolor=color.new(color.blue, 55))
    table.cell(matrix, 2, 0, "Filled", text_color=color.white, bgcolor=color.new(color.blue, 55))
    table.cell(matrix, 3, 0, "Bias", text_color=color.white, bgcolor=color.new(color.blue, 55))
    for r = 0 to rows - 1
        float row_low = range_low + row_step * r
        float row_high = row_low + row_step
        float row_active = 0.0
        float row_filled = 0.0
        float row_bias = 0.0
        if in_matrix_source == "Imbalances" and gap_count > 0
            for i = 0 to gap_count - 1
                float gl = array.get(gap_low, i)
                float gh = array.get(gap_high, i)
                bool intersects = gh >= row_low and gl <= row_high
                if intersects
                    float ga = array.get(gap_active, i)
                    float gt = array.get(gap_total, i)
                    int gd = array.get(gap_dir, i)
                    row_active += ga
                    row_filled += math.max(gt - ga, 0.0)
                    row_bias += gd * ga
        if in_matrix_source == "Pivots" and pivot_count > 0
            for i = 0 to pivot_count - 1
                float pp = array.get(pivot_price, i)
                if pp >= row_low and pp < row_high
                    float pw = array.get(pivot_weight, i)
                    bool pf = array.get(pivot_filled, i)
                    int pd = array.get(pivot_dir, i)
                    row_active += pf ? 0.0 : pw
                    row_filled += pf ? pw : 0.0
                    row_bias += pd * (pf ? 0.0 : pw)
        color bias_color = row_bias > 0.0 ? color.lime : row_bias < 0.0 ? color.red : color.gray
        table.cell(matrix, 0, r + 1, str.tostring((row_low + row_high) * 0.5, format.mintick), text_color=color.white)
        table.cell(matrix, 1, r + 1, str.tostring(row_active, "#"), text_color=color.lime)
        table.cell(matrix, 2, r + 1, str.tostring(row_filled, "#"), text_color=color.gray)
        table.cell(matrix, 3, r + 1, row_bias > 0.0 ? "B" : row_bias < 0.0 ? "S" : "-", text_color=bias_color)
