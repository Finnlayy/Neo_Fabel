//@version=6
// =================================================================================================
// WTI/USDT.P QuantDesk Pro v4.1: Optimized for 1-Min Oil Scalping
// =================================================================================================
// MARGEX PRO CONFIGURATION:
// - initial_capital = 100
// - default_qty_type = strategy.cash
// - default_qty_value = 5 (5 USDT per trade)
// - pyramiding = 1
// - calc_on_every_tick = false
// - process_orders_on_close = true
// - Optimized for WTI volatility (ATR 0.3-1.2 typical on 1m)
// =================================================================================================

strategy(
    title="WTI/USDT.P QuantDesk Pro v4.1",
    shorttitle="WTI 1M Scalper",
    overlay=true,
    initial_capital=100,
    default_qty_type=strategy.cash,
    default_qty_value=5,
    pyramiding=1,
    calc_on_every_tick=false,
    margin_long=0,
    margin_short=0,
    process_orders_on_close=true,
    commission_type=strategy.commission.percent,
    commission_value=0.06,
    slippage=3,
    max_lines_count=100,
    max_labels_count=100,
    max_boxes_count=100
)

// =================================================================================================
// 1. EINSTELLUNGEN (OPTIMIZED FOR WTI 1M)
// =================================================================================================
grp_main = "Haupt-Einstellungen"
uuid = input.string("your-margex-uuid-here", "Signal Bot UUID", group=grp_main)
min_conf = input.int(65, "Min. Confidence Score (50-100)", minval=50, maxval=100, group=grp_main, tooltip="Higher threshold for 1m noise filtering")
use_shorts = input.bool(true, "Short-Trades erlauben", group=grp_main)

grp_risk = "Risiko & Filter (WTI Optimized)"
sl_atr_mul = input.float(0.85, "SL ATR Multiplikator", step=0.05, minval=0.1, maxval=3.0, group=grp_risk, tooltip="Tighter for oil scalping")
tp_atr_mul = input.float(2.1, "TP ATR Multiplikator", step=0.1, minval=0.5, maxval=5.0, group=grp_risk, tooltip="1:2.5 RR ratio")
vol_mult = input.float(1.5, "Volumen Multiplikator", step=0.1, minval=1.0, group=grp_risk, tooltip="Filter low volume bars")
max_dd_pct = input.float(12.0, "Max Drawdown Limit (%)", step=1.0, minval=1.0, maxval=50.0, group=grp_risk)
max_spread = input.float(0.05, "Max Spread ($)", step=0.01, minval=0.01, group=grp_risk, tooltip="Reject if spread > $0.05 (5 cents)")
min_atr = input.float(0.02, "Min ATR Filter ($)", step=0.01, minval=0.01, group=grp_risk, tooltip="Avoid trading during flat periods")
daily_loss_limit = input.float(20.0, "Max Daily Loss ($)", step=1.0, minval=1.0, maxval=200.0, group=grp_risk, tooltip="Circuit breaker for daily realized PnL")

grp_session = "NYMEX Session Filter"
use_session = input.bool(true, "NYMEX Session Filter", group=grp_session)
// NYMEX Crude Oil Hours: 09:00-17:00 EST (UTC-5/4 depending on DST)
// Adjust for your broker's timezone - assuming UTC here
session_time = input.session("1400-2200", "Trading Session (UTC)", group=grp_session, tooltip="NYMEX liquid hours in UTC")

grp_news = "News Filter"
news_bull = input.bool(false, "News: Bullish", group=grp_news)
news_bear = input.bool(false, "News: Bearish", group=grp_news)

grp_vis = "Visualisierung"
show_ob = input.bool(true, "Order Blocks", group=grp_vis)
show_fvg = input.bool(true, "FVGs", group=grp_vis)
show_cisd = input.bool(true, "CISD-Linien", group=grp_vis)

// =================================================================================================
// 2. SYSTEM STATUS & FILTERS
// =================================================================================================
// Session Check (NYMEX Liquid Hours)
bool in_session = not use_session or not na(time(timeframe.period, session_time))

// Drawdown Check
var float peak_equity = strategy.initial_capital
peak_equity := math.max(peak_equity, strategy.equity)
float current_dd_pct = ((peak_equity - strategy.equity) / peak_equity) * 100.0
bool dd_guard_active = current_dd_pct >= max_dd_pct

// Intrabar move filter (proxy for unstable conditions)
float spread_est = math.abs(close - close[1])
bool spread_ok = spread_est <= max_spread

// Daily realized PnL circuit breaker
var float day_start_netprofit = na
if na(day_start_netprofit)
    day_start_netprofit := strategy.netprofit
if ta.change(time("D"))
    day_start_netprofit := strategy.netprofit
float daily_pnl = strategy.netprofit - day_start_netprofit
bool daily_limit_hit = daily_pnl <= -daily_loss_limit

// =================================================================================================
// 3. MTF TREND ANALYSIS (NO REPAINTING)
// =================================================================================================
f_trend_fast() =>
    ema9 = ta.ema(close, 9)
    ema21 = ta.ema(close, 21)
    bull = ema9 > ema21 and close > ema9
    bear = ema9 < ema21 and close < ema9
    [bull, bear]

f_trend_slow() =>
    ema50 = ta.ema(close, 50)
    ema100 = ta.ema(close, 100)
    bull = ema50 > ema100
    bear = ema50 < ema100
    [bull, bear]

// 5M and 15M for WTI (faster than H1/H4 for 1m scalping)
[m5_bull, m5_bear] = request.security(syminfo.tickerid, "5", f_trend_fast(), lookahead=barmerge.lookahead_off)
[m15_bull, m15_bear] = request.security(syminfo.tickerid, "15", f_trend_slow(), lookahead=barmerge.lookahead_off)

// =================================================================================================
// 4. LOKALE INDIKATOREN (1M WTI OPTIMIZED)
// =================================================================================================
atr = ta.atr(14)
atr_safe = math.max(atr, min_atr)
vol_ma = ta.sma(volume, 20)
bool is_vol_high = volume > (vol_ma * vol_mult)

// CISD (Change In State of Delivery) - Optimized for oil
// Using 3-bar pivot for cleaner signals on 1m
pivot_high = ta.pivothigh(high, 3, 3)
pivot_low = ta.pivotlow(low, 3, 3)

var float last_ph = na
var float last_pl = na

// Pivots are already confirmed by ta.pivothigh/low right-bars setting.
if not na(pivot_high)
    last_ph := pivot_high
if not na(pivot_low)
    last_pl := pivot_low

// Breakout logic with buffer for oil volatility
float buffer = atr_safe * 0.1
bool cisd_bull = not na(last_ph) and close > (last_ph + buffer)
bool cisd_bear = not na(last_pl) and close < (last_pl - buffer)

// Draw CISD levels (limit to last bars for performance)
if show_cisd and not na(last_ph) and bar_index % 5 == 0
    line.new(bar_index - 5, last_ph, bar_index, last_ph, color=color.new(color.orange, 70), width=2, style=line.style_dashed)
if show_cisd and not na(last_pl) and bar_index % 5 == 0
    line.new(bar_index - 5, last_pl, bar_index, last_pl, color=color.new(color.aqua, 70), width=2, style=line.style_dashed)

// Order Blocks - Tighter parameters for 1m oil
float body_curr = math.abs(close - open)
float body_prev = math.abs(close[1] - open[1])
float body_avg = ta.sma(body_curr, 10)
float ob_threshold = body_avg * 1.2

bool ob_bull = close[1] < open[1] and close > open and body_curr > ob_threshold and close > open[1]
bool ob_bear = close[1] > open[1] and close < open and body_curr > ob_threshold and close < open[1]

if show_ob and ob_bull
    box.new(bar_index - 3, open[1], bar_index, close[1], bgcolor=color.new(color.green, 90), border_color=color.new(color.green, 50))
if show_ob and ob_bear
    box.new(bar_index - 3, open[1], bar_index, close[1], bgcolor=color.new(color.red, 90), border_color=color.new(color.red, 50))

// FVG (Fair Value Gaps) - 3 candle pattern
bool fvg_bull = low > high[2] and close[1] > open[1] and (low - high[2]) > (atr_safe * 0.2)
bool fvg_bear = high < low[2] and close[1] < open[1] and (low[2] - high) > (atr_safe * 0.2)

if show_fvg and fvg_bull
    box.new(bar_index - 2, high[2], bar_index, low, bgcolor=color.new(color.teal, 92), border_color=color.new(color.teal, 60))
if show_fvg and fvg_bear
    box.new(bar_index - 2, low[2], bar_index, high, bgcolor=color.new(color.maroon, 92), border_color=color.new(color.maroon, 60))

// =================================================================================================
// 5. SCORING ENGINE (0-100) - WEIGHTED FOR OIL
// =================================================================================================
int score_long = 0
int score_short = 0

// MTF Trend Alignment (Higher weight for 1m)
if m5_bull
    score_long += 25
if m5_bear
    score_short += 25
if m15_bull
    score_long += 20
if m15_bear
    score_short += 20

// Structure Breaks
if cisd_bull
    score_long += 25
if cisd_bear
    score_short += 25

// Institutional Levels
if ob_bull
    score_long += 15
if ob_bear
    score_short += 15
if fvg_bull
    score_long += 10
if fvg_bear
    score_short += 10

// External Factors
if news_bull
    score_long += 10
if news_bear
    score_short += 10

// Volume Confirmation (Critical for oil)
if is_vol_high
    score_long += 5
    score_short += 5

// =================================================================================================
// 6. ENTRY / EXIT LOGIK (1M OPTIMIZED)
// =================================================================================================
bool block_long = news_bear or not in_session or dd_guard_active or not spread_ok or daily_limit_hit
bool block_short = news_bull or not in_session or dd_guard_active or not spread_ok or daily_limit_hit

bool confirmed = barstate.isconfirmed

// Additional filters for 1m oil
bool trend_aligned_long = m5_bull or m15_bull
bool trend_aligned_short = m5_bear or m15_bear

bool go_long = confirmed and score_long >= min_conf and not block_long and strategy.position_size == 0 and trend_aligned_long
bool go_short = confirmed and score_short >= min_conf and not block_short and strategy.position_size == 0 and use_shorts and trend_aligned_short

// Dynamic SL/TP based on oil volatility
float sl_long_price = close - (atr_safe * sl_atr_mul)
float tp_long_price = close + (atr_safe * tp_atr_mul)
float sl_short_price = close + (atr_safe * sl_atr_mul)
float tp_short_price = close - (atr_safe * tp_atr_mul)

// Ensure minimum distance (avoid stop hunts)
float min_sl_dist = atr_safe * 0.5
if (close - sl_long_price) < min_sl_dist
    sl_long_price := close - min_sl_dist
if (sl_short_price - close) < min_sl_dist
    sl_short_price := close + min_sl_dist

// Entries
if go_long
    strategy.entry("Long", strategy.long, comment="L" + str.tostring(score_long))
    strategy.exit("Long Exit", "Long", stop=sl_long_price, limit=tp_long_price, comment_loss="SL", comment_profit="TP")

if go_short
    strategy.entry("Short", strategy.short, comment="S" + str.tostring(score_short))
    strategy.exit("Short Exit", "Short", stop=sl_short_price, limit=tp_short_price, comment_loss="SL", comment_profit="TP")

if daily_limit_hit and strategy.position_size != 0
    strategy.close_all(comment="Daily Limit")

// Visuals
plotshape(go_long, "Long Signal", shape.triangleup, location.belowbar, color.lime, size=size.small, text="BUY", textcolor=color.white)
plotshape(go_short, "Short Signal", shape.triangledown, location.abovebar, color.red, size=size.small, text="SELL", textcolor=color.white)

// =================================================================================================
// 7. WEBHOOK ALERTS (MARGEX COMPATIBLE)
// =================================================================================================
// Margex Webhook URL: https://api.margex.com/tradingview/webhook (verify with your account)
// Or use generic format compatible with most platforms
string margex_payload = '{"action":"{{strategy.order.action}}","symbol":"WTIUSDT","price":"{{close}}","quantity":"5","side":"{{strategy.order.action}}","timestamp":"{{timenow}}","uuid":"' + uuid + '","score":"{{strategy.order.comment}}"}'

if go_long or go_short
    alert(margex_payload, alert.freq_once_per_bar_close)

// =================================================================================================
// 8. WTI DASHBOARD (1M SCALPING INFO)
// =================================================================================================
var table dash = table.new(position.top_right, 2, 11, bgcolor=color.new(#0f172a, 10), border_width=1, border_color=color.new(#334155, 0))

if barstate.islast
    table.cell(dash, 0, 0, "WTI Scalper v4.1", text_color=color.white, text_size=size.small, bgcolor=color.new(#1e293b, 0))
    table.cell(dash, 1, 0, "1M Chart", text_color=color.new(#38bdf8, 0), text_size=size.small, bgcolor=color.new(#1e293b, 0))

    table.cell(dash, 0, 1, "Session", text_color=color.new(#94a3b8, 0), text_size=size.small)
    table.cell(dash, 1, 1, in_session ? "NYMEX OPEN" : "CLOSED", text_color=in_session ? color.new(#10b981, 0) : color.new(#f43f5e, 0), text_size=size.small)

    table.cell(dash, 0, 2, "Spread", text_color=color.new(#94a3b8, 0), text_size=size.small)
    table.cell(dash, 1, 2, str.tostring(spread_est, "#.##") + "$", text_color=spread_ok ? color.new(#10b981, 0) : color.new(#f43f5e, 0), text_size=size.small)

    table.cell(dash, 0, 3, "Drawdown", text_color=color.new(#94a3b8, 0), text_size=size.small)
    table.cell(dash, 1, 3, str.tostring(current_dd_pct, "#.#") + "%", text_color=dd_guard_active ? color.new(#f43f5e, 0) : color.white, text_size=size.small)

    table.cell(dash, 0, 4, "M5 Trend", text_color=color.new(#94a3b8, 0), text_size=size.small)
    table.cell(dash, 1, 4, m5_bull ? "BULL" : m5_bear ? "BEAR" : "NEUTRAL", text_color=m5_bull ? color.new(#10b981, 0) : m5_bear ? color.new(#f43f5e, 0) : color.gray, text_size=size.small)

    table.cell(dash, 0, 5, "M15 Macro", text_color=color.new(#94a3b8, 0), text_size=size.small)
    table.cell(dash, 1, 5, m15_bull ? "BULL" : m15_bear ? "BEAR" : "NEUTRAL", text_color=m15_bull ? color.new(#10b981, 0) : m15_bear ? color.new(#f43f5e, 0) : color.gray, text_size=size.small)

    table.cell(dash, 0, 6, "ATR(14)", text_color=color.new(#94a3b8, 0), text_size=size.small)
    table.cell(dash, 1, 6, str.tostring(atr_safe, "#.##") + "$", text_color=atr_safe >= min_atr ? color.white : color.new(#f59e0b, 0), text_size=size.small)

    table.cell(dash, 0, 7, "Long Score", text_color=color.new(#94a3b8, 0), text_size=size.small)
    table.cell(dash, 1, 7, str.tostring(score_long) + "/100", text_color=score_long >= min_conf ? color.new(#10b981, 0) : color.white, text_size=size.small)

    table.cell(dash, 0, 8, "Short Score", text_color=color.new(#94a3b8, 0), text_size=size.small)
    table.cell(dash, 1, 8, str.tostring(score_short) + "/100", text_color=score_short >= min_conf ? color.new(#f43f5e, 0) : color.white, text_size=size.small)

    table.cell(dash, 0, 9, "Win Rate", text_color=color.new(#94a3b8, 0), text_size=size.small)
    float wr = strategy.closedtrades > 0 ? (strategy.wintrades * 100.0 / strategy.closedtrades) : 0.0
    table.cell(dash, 1, 9, str.tostring(wr, "#.#") + "%", text_color=wr >= 55 ? color.new(#10b981, 0) : color.new(#f59e0b, 0), text_size=size.small)

    table.cell(dash, 0, 10, "P&L", text_color=color.new(#94a3b8, 0), text_size=size.small)
    table.cell(dash, 1, 10, str.tostring(strategy.netprofit, "#.##") + " $", text_color=strategy.netprofit >= 0 ? color.new(#10b981, 0) : color.new(#f43f5e, 0), text_size=size.small)
